---
// 项目卡片：展示名称、描述、状态徽章、平台，链接到 /projects/[slug]/
// 项目详情页在双语范围内，href 需要按当前 locale 生成
// 视觉语法全部来自 global.css 的 .app-card 一族——与 ToolCard 共用同一套，不再各写一份内联 Tailwind
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Project } from '../data/projects';
import { CATEGORY_LABELS } from '../data/projects';
import { resolveLocale, t } from '../i18n/strings';
import { Image } from 'astro:assets';

interface Props {
	/** src/data/projects.ts 中的项目元数据 */
	project: Project;
	/** 是否在标签行首位展示分类标签（分组展示的列表页已用小标题区分分类，无需重复；平铺展示的首页/关于页需要） */
	showCategory?: boolean;
	/** 特色卡：跨满整行、信息放大一档，用于列表页每个分类组的第一项 */
	featured?: boolean;
}

const { project, showCategory = false, featured = false } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const href = getRelativeLocaleUrl(locale, `projects/${project.slug}`);
const statusLabels: Record<Project['status'], string> = {
	development: '开发中',
	beta: '测试中',
	released: '已发布',
};
const name = t(locale, `project.${project.slug}.name`, project.name);
const description = t(locale, `project.${project.slug}.description`, project.description);
const statusLabel = t(locale, `status.${project.status}`, statusLabels[project.status]);
const categoryLabel = t(locale, `category.${project.category}`, CATEGORY_LABELS[project.category]);
---

<a
	href={href}
	class:list={['app-card', featured && 'app-card--featured col-span-full']}
>
	<div class="app-card-main">
		<div class="app-card-head">
			{
				// alt="" 是有意的：图标右侧就是同一个项目的标题，读屏会连念两遍。
				// 原先写的「XX 图标」属于装饰图带冗余替代文本，不是漏填
				project.icon && (
					<span class="app-card-icon">
						<Image
							class="h-full w-full object-cover"
							src={project.icon}
							alt=""
							width={88}
							height={88}
							loading={featured ? 'eager' : 'lazy'}
							decoding="async"
						/>
					</span>
				)
			}
			<h3 class="app-card-title">
				<span class="app-card-mark">{name}</span>
			</h3>
			<span class={`badge badge-${project.status}`}>{statusLabel}</span>
		</div>
		<p class="app-card-desc">{description}</p>
		<div class="app-card-foot">
			{showCategory && <span class="tag-pill">{categoryLabel}</span>}
			{project.platforms.map((platform) => (
				<span class="tag-pill">{platform}</span>
			))}
		</div>
	</div>
</a>
