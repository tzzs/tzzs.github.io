---
// 项目卡片：展示名称、描述、状态徽章、平台，链接到 /projects/[slug]/
// 项目详情页在双语范围内，href 需要按当前 locale 生成
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Project } from '../data/projects';
import { CATEGORY_LABELS } from '../data/projects';
import { resolveLocale, t } from '../i18n/strings';
import { Image } from 'astro:assets';

interface Props {
	/** src/data/projects.ts 中的项目元数据 */
	project: Project;
	/** 是否在标签行首位展示分类标签（分组展示的列表页已用小标题区分分类，无需重复；平铺展示的首页/关于页需要） */
	showCategory?: boolean;
}

const { project, showCategory = false } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const href = getRelativeLocaleUrl(locale, `projects/${project.slug}`);
const statusLabels: Record<Project['status'], string> = {
	development: '开发中',
	beta: '测试中',
	released: '已发布',
};
const name = t(locale, `project.${project.slug}.name`, project.name);
const description = t(locale, `project.${project.slug}.description`, project.description);
const statusLabel = t(locale, `status.${project.status}`, statusLabels[project.status]);
const categoryLabel = t(locale, `category.${project.category}`, CATEGORY_LABELS[project.category]);
---

<a
	href={href}
	class="group block rounded-[var(--radius-card)] border border-[var(--border-strong)] bg-bg p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-green-strong hover:shadow-[var(--shadow)]"
>
	<div class="flex items-center gap-2.5">
		{
			project.icon && (
				<Image
					class="h-8 w-8 shrink-0 rounded-md"
					src={project.icon}
					alt={`${project.name} 图标`}
					width={32}
					height={32}
					loading="lazy"
					decoding="async"
				/>
			)
		}
		<h3 class="min-w-0 flex-1 font-bold text-lg text-[var(--text)]">
			{
				/* 标题 hover 变品牌绿底黑字色块（与 Hero 徽章同款），色块只包住文字不撑满整行 */
				<span class="inline-block rounded-md px-1.5 transition-colors duration-200 group-hover:bg-green group-hover:text-black">
					{name}
				</span>
			}
		</h3>
		<span class={`badge badge-${project.status}`}>
			{statusLabel}
		</span>
	</div>
	<p class="mt-2 text-sm leading-relaxed text-[var(--text-soft)]">{description}</p>
	<div class="mt-3 flex flex-wrap gap-2">
		{showCategory && (
			<span class="tag-pill">
				{categoryLabel}
			</span>
		)}
		{
			project.platforms.map((platform) => (
				<span class="tag-pill">{platform}</span>
			))
		}
	</div>
</a>
