---
// 文章卡片：展示标题、日期、描述、标签，链接到 /blog/[slug]/
// 文章详情页不在双语范围内（正文本身是不翻译的中文长文），href 两种语言下都保持不带前缀
import type { CollectionEntry } from 'astro:content';
import { resolveLocale, t } from '../i18n/strings';
import TagList from './TagList.astro';

interface Props {
	/** 博客集合条目（getCollection('blog') 的返回值） */
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags = [] } = post.data;
const href = `/blog/${post.id}/`;
const locale = resolveLocale(Astro.currentLocale);
// pubDate 是纯日期字符串（z.coerce.date() 解析为 UTC 午夜），固定按 UTC 格式化，
// 避免构建机时区把日期偏移一天（负偏移时区会推到前一天）
const dateText = pubDate.toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', {
	timeZone: 'UTC',
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<article class="rounded-[var(--radius-card)] border border-[var(--border)] bg-bg p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)] hover:shadow-[var(--shadow)]">
	<time class="text-sm text-[var(--text-faint)]" datetime={pubDate.toISOString()}>{dateText}</time>
	<h2 class="mt-2 text-xl font-bold text-[var(--text)]">
		<a class="transition-colors duration-150 hover:text-[var(--accent)]" href={href}>{title}</a>
	</h2>
	{
		/* description 过滤：过短的碎片描述（如 "Problem"）不显示，避免卡片空洞 */
		description && description.length >= 10 && (
			<p class="mt-2 text-sm leading-relaxed text-[var(--text-soft)]">{description}</p>
		)
	}
	{
		tags.length > 0 && (
			<div class="mt-3">
				<TagList tags={tags} />
			</div>
		)
	}
	<a class="mt-3 inline-block text-sm font-medium text-[var(--accent)] hover:underline" href={href}>{t(locale, 'postCard.readMore', '阅读全文 →')}</a>
</article>
