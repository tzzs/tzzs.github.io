---
// 页脚（Positivus 风格）：深色背景 + 站点链接 + 社交/源码链接 + 版权
import { SITE_TITLE, COPYRIGHT_HOLDER, SITE_URL } from '../consts';

const navLinks = [
	{ name: '首页', href: '/', i18nKey: 'nav.home' },
	{ name: '项目', href: '/projects/', i18nKey: 'nav.projects' },
	{ name: '博客', href: '/blog/', i18nKey: 'nav.blog' },
	{ name: '关于', href: '/about/', i18nKey: 'nav.about' },
	{ name: '联系', href: '/contact/', i18nKey: 'nav.contact' },
];

const externalLinks = [
	{ name: 'GitHub', href: 'https://github.com/tzzs' },
	{ name: 'RSS', href: '/rss.xml' },
];
---

<footer class="px-5 pt-8 sm:px-5">
	<div class="mx-auto w-full max-w-[1240px]">
		<div class="rounded-t-[45px] bg-dark px-[15px] py-8 text-gray lg:px-[60px]">
			<div class="flex flex-col items-center justify-between gap-6 lg:flex-row">
				<a href="/" class="flex items-center gap-2">
					<span class="inline-block h-8 w-8 rounded-lg bg-green" aria-hidden="true"></span>
					<span class="text-xl font-bold tracking-tight text-white">{SITE_TITLE}</span>
				</a>

				<ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 sm:gap-6">
					{
						navLinks.map((link) => (
							<li>
								<a
									class="text-sm text-gray underline underline-offset-4 hover:text-green"
									href={link.href}
									data-i18n-key={link.i18nKey}
								>
									{link.name}
								</a>
							</li>
						))
					}
				</ul>

				<ul class="flex gap-4">
					{
						externalLinks.map((link) => (
							<li>
								<a
									class="inline-block rounded-full border border-gray px-5 py-2 text-sm text-gray transition-colors duration-150 hover:border-green hover:text-green"
									href={link.href}
									target={link.href.startsWith('http') ? '_blank' : undefined}
									rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									{link.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="mt-6 mb-4 h-px bg-gray"></div>

			<div class="flex flex-col items-center justify-between gap-3 text-center text-sm text-gray md:flex-row">
				<span>
					© {new Date().getFullYear()} {COPYRIGHT_HOLDER} · <span data-i18n-key="footer.rights">保留所有权利</span>
				</span>
				<a class="underline underline-offset-4 hover:text-green" href={SITE_URL}>
					{SITE_URL.replace('https://', '')}
				</a>
			</div>
		</div>
	</div>
</footer>
