---
// 博客列表内容（分页第 1 页 /blog/ 与后续 /blog/page/N/ 共用）
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import { pageUrl } from '../lib/paginate';

interface Props {
	page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;
---

<header class="mb-6">
	<h1 class="text-3xl font-bold">博客</h1>
	<p class="mt-1 text-sm text-[var(--text-faint)]">共 {page.total} 篇文章</p>
</header>

<div class="flex flex-col gap-6">
	{page.data.map((post) => <PostCard post={post} />)}
</div>

<Pagination page={page.currentPage} total={page.lastPage} url={pageUrl} />
