---
// 顶部导航（Positivus 风格）：Logo + 导航链接 + 移动端汉堡菜单 + 主题/语言切换
// 语言切换是原生 i18n 路由下的真实跳转链接（见 astro.config.mjs 的 i18n 配置），
// 不再是客户端换字典——每个 <a> 的文案/href 在这里就已经按当前 locale 解析好。
import { getRelativeLocaleUrl } from 'astro:i18n';
import { resolveLocale, t } from '../i18n/strings';
import { SITE_TITLE } from '../consts';

interface Props {
	/** 没有传时（范围外的中文专属页面）语言切换按钮不显示，见 MainLayout.astro 的同名 prop 说明 */
	hasEnglishVersion?: boolean;
}
const { hasEnglishVersion = false } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const otherLocale = locale === 'zh' ? 'en' : 'zh';

const navItems = [
	{ path: '', zh: '首页', en: 'Home' },
	{ path: 'projects', zh: '项目', en: 'Projects' },
	{ path: 'blog', zh: '博客', en: 'Blog' },
	{ path: 'about', zh: '关于', en: 'About' },
	{ path: 'contact', zh: '联系', en: 'Contact' },
].map((item) => ({
	href: getRelativeLocaleUrl(locale, item.path),
	label: locale === 'zh' ? item.zh : item.en,
}));

const { pathname } = Astro.url;
const homeHref = getRelativeLocaleUrl(locale, '');
const timelineHref = getRelativeLocaleUrl(locale, 'blog/timeline');
const isActive = (href: string) => {
	if (href === homeHref) return pathname === homeHref;
	// 时间轴不占导航位（从博客页横幅进入），其页面不高亮任何 tab
	if (pathname.startsWith(timelineHref)) return false;
	return pathname.startsWith(href);
};

// 语言切换：同一路径换一个语言。prefixDefaultLocale:false 下中文无前缀、英文带 /en 前缀，
// 互相转换只需要加/去掉这一个固定前缀。
const barePath = pathname.replace(/^\/en(\/|$)/, '/').replace(/^\/|\/$/g, '');
const toggleHref = getRelativeLocaleUrl(otherLocale, barePath);
const showToggle = locale === 'en' || hasEnglishVersion;
const toggleLabel = locale === 'zh' ? 'EN' : '中文';
const toggleAriaLabel = locale === 'zh' ? 'Switch to English' : '切换到中文';
---

<header
	id="site-header"
	class="sticky top-0 z-50 border-b border-transparent bg-transparent transition-all duration-200"
>
	<nav class="mx-auto flex w-full max-w-[1240px] items-center justify-between px-5 py-4">
		<!-- 可访问名称需包含可见文字（SITE_TITLE），满足 Lighthouse label-content-name 审计 -->
		<a href={homeHref} id="site-logo" class="flex items-center gap-2" aria-label={`${SITE_TITLE} · ${t(locale, 'nav.home', '返回首页')}`}>
			<span class="inline-block h-8 w-8 rounded-lg bg-green" aria-hidden="true"></span>
			<span class="text-xl font-bold tracking-tight">{SITE_TITLE}</span>
		</a>

		<!-- 桌面端导航（ml-auto 推向右，与旧布局一致） -->
		<ul class="hidden items-center gap-8 md:ml-auto md:flex">
			{
				navItems.map((item) => (
					<li>
						<a
							href={item.href}
							class:list={[
								'rounded-full px-4 py-2 text-sm font-medium transition-colors duration-150',
								isActive(item.href)
									? 'bg-[var(--text)] text-[var(--bg)]'
									: 'text-[var(--text)] hover:bg-[var(--bg-hover)]',
							]}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="ml-6 flex items-center gap-3">
			<!-- 主题切换按钮：深色模式显示太阳（点击回浅色），浅色模式显示月亮；无边框，hover 圆形浅底 -->
			<button
				id="theme-toggle"
				type="button"
				class="flex h-10 w-10 items-center justify-center rounded-full text-[var(--text-soft)] transition-colors duration-150 hover:bg-[var(--bg-hover)] hover:text-[var(--text)]"
				aria-label={t(locale, 'nav.themeToggle', '切换主题')}
			>
				<svg id="theme-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="hidden h-5 w-5">
					<circle cx="12" cy="12" r="4"></circle>
					<path stroke-linecap="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
				</svg>
				<svg id="theme-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-5 w-5">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>

			<!-- 语言切换：真实跳转链接（对应 URL 在原生 i18n 路由下已经是构建好的静态页面），
			     没有英文版的页面（hasEnglishVersion 为 false 且当前不在 /en/ 下）直接不渲染这个入口 -->
			{
				showToggle && (
					<a
						id="lang-toggle"
						href={toggleHref}
						hreflang={otherLocale}
						aria-label={toggleAriaLabel}
						class="flex h-10 min-w-10 items-center justify-center rounded-full px-2 text-xs font-semibold tracking-wide text-[var(--text-soft)] transition-colors duration-150 hover:bg-[var(--bg-hover)] hover:text-[var(--text)]"
					>
						{toggleLabel}
					</a>
				)
			}

			<!-- 移动端汉堡按钮 -->
			<button
				id="nav-toggle"
				type="button"
				class="flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--text)] md:hidden"
				aria-label={t(locale, 'nav.menuToggle', '切换导航菜单')}
				aria-expanded="false"
				aria-controls="nav-mobile"
			>
				<svg id="nav-open-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-6 w-6">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
				<svg id="nav-close-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="hidden h-6 w-6">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
	</nav>

	<!-- 移动端下拉菜单 -->
	<div id="nav-mobile" class="hidden border-t border-[var(--border)] bg-[var(--bg)] md:hidden">
		<ul class="flex flex-col px-5 py-2">
			{
				navItems.map((item) => (
					<li>
						<a
							href={item.href}
							class:list={[
								'block rounded-lg px-3 py-3 text-base font-medium',
								isActive(item.href)
									? 'bg-[var(--text)] text-[var(--bg)]'
									: 'text-[var(--text)] hover:bg-[var(--bg-hover)]',
							]}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>

<script>
	import {
		CHRISTMAS_OPEN_EVENT,
		CHRISTMAS_CLICK_THRESHOLD,
		CHRISTMAS_CLICK_WINDOW_MS,
		CHRISTMAS_NAV_DEBOUNCE_MS,
	} from '../lib/christmas';

	// 沉浸式导航：页面在顶部时透明融入内容，滚动后浮出底色 + 边框 + 模糊
	// 底色/边框用 CSS 变量（--nav-bg / --nav-border），深色模式下自动跟随主题
	const header = document.getElementById('site-header');
	if (header) {
		const applyNavState = () => {
			const scrolled = window.scrollY > 0;
			header.classList.toggle('bg-[var(--nav-bg)]', scrolled);
			header.classList.toggle('border-[var(--nav-border)]', scrolled);
			header.classList.toggle('backdrop-blur', scrolled);
			header.classList.toggle('bg-transparent', !scrolled);
			header.classList.toggle('border-transparent', !scrolled);
		};
		window.addEventListener('scroll', applyNavState, { passive: true });
		applyNavState();
	}

	// 主题切换：点击后写 data-theme + localStorage，图标随当前主题显隐
	// 初始 data-theme 由 BaseLayout 内联脚本设置，未设置时跟随系统偏好
	const themeToggle = document.getElementById('theme-toggle') as HTMLButtonElement;
	const themeSun = document.getElementById('theme-sun') as unknown as SVGElement;
	const themeMoon = document.getElementById('theme-moon') as unknown as SVGElement;

	const isDarkTheme = () => {
		const root = document.documentElement;
		if (root.getAttribute('data-theme') === 'dark') return true;
		if (root.getAttribute('data-theme') === 'light') return false;
		return window.matchMedia('(prefers-color-scheme: dark)').matches;
	};

	const syncThemeIcon = () => {
		const dark = isDarkTheme();
		themeSun.classList.toggle('hidden', !dark);
		themeMoon.classList.toggle('hidden', dark);
	};

	if (themeToggle && themeSun && themeMoon) {
		syncThemeIcon();
		themeToggle.addEventListener('click', () => {
			const root = document.documentElement;
			const next = isDarkTheme() ? 'light' : 'dark';
			root.setAttribute('data-theme', next);
			localStorage.setItem('theme', next);
			syncThemeIcon();
		});
	}

	// 移动端汉堡菜单切换（纯原生实现）
	const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
	const mobile = document.getElementById('nav-mobile') as HTMLDivElement;
	const openIcon = document.getElementById('nav-open-icon') as unknown as SVGElement;
	const closeIcon = document.getElementById('nav-close-icon') as unknown as SVGElement;

	if (toggle && mobile) {
		toggle.addEventListener('click', () => {
			const isOpen = !mobile.classList.contains('hidden');
			mobile.classList.toggle('hidden', isOpen);
			openIcon.classList.toggle('hidden', !isOpen);
			closeIcon.classList.toggle('hidden', isOpen);
			toggle.setAttribute('aria-expanded', String(!isOpen));
		});
		// 点击菜单项后自动收起
		mobile.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				mobile.classList.add('hidden');
				openIcon.classList.remove('hidden');
				closeIcon.classList.add('hidden');
				toggle.setAttribute('aria-expanded', 'false');
			});
		});
	}

	// 圣诞彩蛋：连续点击 Logo 5 次（1.5s 滚动窗口内）打开全屏彩蛋，替代跳转首页。
	// 站点是纯 MPA（无客户端路由），<a href> 默认点击即整页跳转，计数器活不过第一次点击，
	// 因此无条件拦截左键单击，未达阈值时用去抖延迟模拟"正常单击"跳转（唯一代价：单击 Logo 到
	// 真正跳转之间约 400ms 延迟）。保留 Ctrl/Cmd/Shift/Alt+点击的浏览器原生行为，不拦截不计数。
	// logoLink.href 会随渲染时的 locale 指向 / 或 /en/，这里不需要关心，读的是运行时属性值。
	const logoLink = document.getElementById('site-logo') as HTMLAnchorElement | null;
	if (logoLink) {
		let clickTimestamps: number[] = [];
		let navTimer: ReturnType<typeof setTimeout> | undefined;

		logoLink.addEventListener('click', (e) => {
			if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
			e.preventDefault();

			const now = Date.now();
			clickTimestamps.push(now);
			clickTimestamps = clickTimestamps.filter((t) => now - t <= CHRISTMAS_CLICK_WINDOW_MS);

			if (navTimer !== undefined) clearTimeout(navTimer);

			if (clickTimestamps.length >= CHRISTMAS_CLICK_THRESHOLD) {
				clickTimestamps = [];
				window.dispatchEvent(new CustomEvent(CHRISTMAS_OPEN_EVENT));
				return;
			}

			navTimer = setTimeout(() => {
				window.location.href = logoLink.href;
			}, CHRISTMAS_NAV_DEBOUNCE_MS);
		});
	}
</script>
