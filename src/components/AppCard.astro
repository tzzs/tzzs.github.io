---
// 应用卡片：展示名称、描述、状态徽章、平台，链接到 /apps/[slug]/
import type { App } from '../data/apps';

interface Props {
	/** src/data/apps.ts 中的应用元数据 */
	app: App;
}

const { app } = Astro.props;
const href = `/apps/${app.slug}/`;
const statusLabels: Record<App['status'], string> = {
	development: '开发中',
	beta: '测试中',
	released: '已发布',
};
---

<article class="app-card">
	<a href={href}>
		<div class="app-card-header">
			<h3>{app.name}</h3>
			<span class={`badge badge-${app.status}`}>{statusLabels[app.status]}</span>
		</div>
		<p class="app-card-desc">{app.description}</p>
		<div class="app-card-platforms">
			{
				app.platforms.map((platform) => (
					<span class="platform">{platform}</span>
				))
			}
		</div>
	</a>
</article>
