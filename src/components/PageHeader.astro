---
// 内页统一页头（以项目列表页为样板）：大标题 + 英文徽章 + 描述
// 顶部间距 pt-12 md:pt-16 与标题字号 text-4xl md:text-5xl 与 /projects/ 保持一致
interface Props {
	/** 中文大标题 */
	title: string;
	/** 英文徽章文字（如 Blog / Archive），不传则不显示 */
	badge?: string;
	/** 副标题描述，不传则不显示 */
	description?: string;
	/**
	 * description 的 i18n 字典 key（src/i18n/strings.ts），传了才参与语言切换。
	 * title 不提供对应 key：title 旁边常年跟着英文 badge，若 title 也翻译成英文会跟 badge 重复（"Projects Projects"），
	 * 索性让 title 始终保持中文，由 badge 承担这个页头的英文识别。
	 */
	descriptionKey?: string;
}

const { title, badge, description, descriptionKey } = Astro.props;
---

<section class="pb-10 pt-12 md:pt-16">
	<h1 class="text-4xl font-bold tracking-tight md:text-5xl">
		{title}
		{
			badge && (
				<span class="ml-3 inline-block rounded-xl bg-green px-4 py-1 text-2xl font-semibold align-middle md:text-3xl">
					{badge}
				</span>
			)
		}
	</h1>
	{
		description && (
			<p class="mt-4 max-w-2xl text-lg leading-relaxed text-text-soft" data-i18n-key={descriptionKey}>
				{description}
			</p>
		)
	}
</section>
