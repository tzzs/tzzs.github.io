---
// 主布局（Positivus 风格）：BaseLayout（head：SEO + 统计脚本）+ Navbar + 内容区 + Footer
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ChristmasEasterEgg from '../components/ChristmasEasterEgg.astro';
import { resolveLocale } from '../i18n/strings';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	/**
	 * 只在渲染中文（默认语言）页面时会被读取，决定 Navbar 要不要显示指向 /en/ 对应页面的语言
	 * 切换入口；默认 false（没有英文版就不显示切换按钮）。渲染 /en/ 页面时这个 prop 被忽略——
	 * 英文页面既然存在，就一定有对应的中文版可以切回去，切换入口总是显示。
	 */
	hasEnglishVersion?: boolean;
}

const { title, description, image, hasEnglishVersion = false } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
---

<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
	<head>
		<BaseLayout title={title} description={description} image={image} />
	</head>
	<body class="flex min-h-screen flex-col bg-white font-grotesk text-black antialiased">
		<Navbar hasEnglishVersion={hasEnglishVersion} />
		<main class="mx-auto w-full max-w-[1240px] flex-1 px-5">
			<slot />
		</main>
		<Footer />
		<ChristmasEasterEgg />
	</body>
</html>
