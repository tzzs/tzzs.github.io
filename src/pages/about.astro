---
// 关于页（Positivus 风格）：大标题「关于」+ 自我介绍 / 技术栈 / 正在开发的应用 / GitHub 主页
import MainLayout from '../layouts/MainLayout.astro';
import AppCard from '../components/AppCard.astro';
import { SITE_TITLE } from '../consts';
import { apps } from '../data/apps';

const githubUrl = 'https://github.com/tzzs';
const techStack = ['Java', 'C', 'Python', 'Go', 'Linux', '数据库'];
---

<MainLayout
	title={`关于 - ${SITE_TITLE}`}
	description="TZZ 的个人简介：技术方向、正在开发的应用与开源主页"
>
	<article class="py-12 md:py-16">
		<header>
			<h1 class="text-5xl font-medium leading-none md:text-7xl">
				关于<span class="ml-3 inline-block rounded-2xl bg-green px-3 py-1">我</span>
			</h1>
			<p class="mt-7 max-w-2xl text-lg leading-relaxed text-[var(--text-soft)]">
				你好，我是 <strong class="font-bold text-black">TZZ</strong>，
				<strong class="font-bold text-black">{SITE_TITLE}</strong> 的开发者与维护者。
			</p>
		</header>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1">自我</span>介绍
			</h2>
			<div class="mt-6 max-w-3xl space-y-4 text-base leading-relaxed">
				<p>
					一名热爱技术的独立开发者，主要使用 <strong class="font-bold">Java、C、Python、Go</strong>
					进行开发，日常在 <strong class="font-bold">Linux</strong> 环境下工作，
					关注<strong class="font-bold">数据库</strong>设计与优化。
					相信小而精的工具能带来更好的体验，喜欢把想法做成真正可用的产品，
					并在这里记录开发过程中的经验与思考。
				</p>
				<p>
					本站既是个人主页，也是产品展示与技术博客：在
					<a class="font-medium text-accent underline-offset-4 hover:underline" href="/apps/">应用</a>
					栏目可以看到我正在开发的产品，在
					<a class="font-medium text-accent underline-offset-4 hover:underline" href="/blog/">博客</a>
					栏目可以阅读技术文章。
				</p>
			</div>
		</section>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1">技术</span>栈
			</h2>
			<ul class="tag-list mt-6">
				{
					techStack.map((tech) => (
						<li>
							<span class="tag-pill px-3.5 py-1.5 text-sm">{tech}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1">正在开发</span>的应用
			</h2>
			<p class="mt-6 max-w-3xl text-base leading-relaxed text-[var(--text-soft)]">
				以下应用正在开发中，欢迎关注
				<a class="font-medium text-accent underline-offset-4 hover:underline" href="/apps/">应用列表页</a>
				获取最新进展：
			</p>
			<div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
				{apps.map((app) => <AppCard app={app} />)}
			</div>
		</section>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1">开源</span>主页
			</h2>
			<p class="mt-6 max-w-3xl text-base leading-relaxed text-[var(--text-soft)]">
				我的开源项目托管在 GitHub：
				<a class="font-medium text-accent underline-offset-4 hover:underline" href={githubUrl} rel="noopener noreferrer" target="_blank">{githubUrl}</a>
			</p>
			<a class="btn-secondary mt-7" href={githubUrl} rel="noopener noreferrer" target="_blank">
				访问 GitHub 主页
			</a>
		</section>
	</article>
</MainLayout>
