---
// 关于页（Positivus 风格）：大标题「关于」+ 自我介绍 / 技术栈 / 我的项目 / 联系方式
// 原独立的 /contact/ 页已并入本页末尾「联系方式」区块，contact.* 文案 key 沿用原名。
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE } from '../consts';
import { projects } from '../data/projects';

const githubUrl = 'https://github.com/tzzs';
const githubIssues = 'https://github.com/tzzs/tzzs.github.io/issues';
const techStack = ['Java', 'C', 'Python', 'Go', 'Linux', '数据库'];
const cardClass =
	'rounded-[var(--radius-card)] border-2 border-[light-dark(#191a23,#4f515c)] bg-[var(--bg-soft)] p-7 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[var(--shadow)]';
---

<MainLayout
	title={`关于 - ${SITE_TITLE}`}
	description="TZZ 的个人简介：技术方向、正在参与的项目，以及 GitHub Issues 等联系方式"
	hasEnglishVersion
>
	<article class="py-12 md:py-16">
		<header>
			<h1 class="text-5xl font-medium leading-none md:text-7xl">
				<span data-i18n-key="about.titlePrefix">关于</span><span class="ml-3 inline-block rounded-2xl bg-green px-3 py-1" data-i18n-key="about.titleSuffix">我</span>
			</h1>
			<p class="mt-7 max-w-2xl text-lg leading-relaxed text-[var(--text-soft)]">
				<span data-i18n-key="about.introPrefix">你好，我是</span> <strong class="font-bold text-[var(--text)]">TZZ</strong><span data-i18n-key="about.introSuffix">，
				独立开发者，平时做点开发工具，写写技术博客。</span>
			</p>
		</header>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1" data-i18n-key="about.selfIntroPrefix">自我</span><span data-i18n-key="about.selfIntroSuffix">介绍</span>
			</h2>
			<div class="mt-6 max-w-3xl text-base leading-relaxed">
				<p>
					<span data-i18n-key="about.selfIntroBodyPrefix">一名热爱技术的独立开发者。正在做的项目可以在下方「我的项目」中查看，
					或前往</span> <a class="font-medium text-accent underline-offset-4 hover:underline" href="/projects/" data-i18n-key="about.projectsListLink">项目列表页</a><span data-i18n-key="about.selfIntroBodySuffix">。</span>
				</p>
			</div>
		</section>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1" data-i18n-key="about.techStackPrefix">技术</span><span data-i18n-key="about.techStackSuffix">栈</span>
			</h2>
			<ul class="tag-list mt-6">
				{
					techStack.map((tech) => (
						<li>
							<span class="tag-pill px-3.5 py-1.5 text-sm">{tech}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1" data-i18n-key="about.myProjectsPrefix">我的</span><span data-i18n-key="about.myProjectsSuffix">项目</span>
			</h2>
			<p class="mt-6 max-w-3xl text-base leading-relaxed text-[var(--text-soft)]">
				<span data-i18n-key="about.myProjectsBodyPrefix">以下是我参与的项目，欢迎关注</span>
				<a class="font-medium text-accent underline-offset-4 hover:underline" href="/projects/" data-i18n-key="about.projectsListLink">项目列表页</a>
				<span data-i18n-key="about.myProjectsBodySuffix">获取最新进展：</span>
			</p>
			<div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
				{projects.map((project) => <ProjectCard project={project} showCategory />)}
			</div>
		</section>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1" data-i18n-key="contact.sectionPrefix">联系</span><span data-i18n-key="contact.sectionSuffix">方式</span>
			</h2>
			<p class="mt-6 max-w-3xl text-base leading-relaxed text-[var(--text-soft)]" data-i18n-key="contact.intro">
				有任何问题、建议或合作意向，欢迎通过以下方式联系。
			</p>
			<div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
				<section class={cardClass}>
					<div class="flex items-center justify-between gap-4">
						<h3 class="text-xl font-medium">GitHub Issues</h3>
						<span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-green" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
								<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
							</svg>
						</span>
					</div>
					<p class="mt-4 text-sm leading-relaxed text-[var(--text-soft)]">
						<span data-i18n-key="contact.issuesBodyPrefix">遇到本站或应用的 Bug、有功能建议，欢迎到</span>
						<a class="font-medium text-accent underline-offset-4 hover:underline" href={githubIssues} rel="noopener noreferrer" target="_blank" data-i18n-key="contact.issuesLinkText">仓库 Issues</a>
						<span data-i18n-key="contact.issuesBodySuffix">反馈，我会尽快跟进处理。</span>
					</p>
				</section>

				<section class={cardClass}>
					<div class="flex items-center justify-between gap-4">
						<h3 class="text-xl font-medium" data-i18n-key="contact.openSourceTitle">开源主页</h3>
						<span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-green" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
								<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
							</svg>
						</span>
					</div>
					<p class="mt-4 text-sm leading-relaxed text-[var(--text-soft)]">
						<span data-i18n-key="contact.openSourceBodyPrefix">我的开源项目与代码仓库都托管在 GitHub：</span>
						<a class="font-medium text-accent underline-offset-4 hover:underline" href={githubUrl} rel="noopener noreferrer" target="_blank">{githubUrl}</a>
					</p>
					<a class="btn-secondary mt-6" href={githubUrl} rel="noopener noreferrer" target="_blank" data-i18n-key="about.visitGithub">
						访问 GitHub 主页
					</a>
				</section>

				<section class={`${cardClass} md:col-span-2`}>
					<div class="flex items-center justify-between gap-4">
						<h3 class="text-xl font-medium" data-i18n-key="contact.noteTitle">说明</h3>
						<span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-green" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="12" y1="16" x2="12" y2="12"></line>
								<line x1="12" y1="8" x2="12.01" y2="8"></line>
							</svg>
						</span>
					</div>
					<p class="mt-4 text-sm leading-relaxed text-[var(--text-soft)]">
						<span data-i18n-key="contact.noteBody">回复一般需要 1-3 个工作日；问题反馈请尽量描述复现步骤与环境，便于快速定位。</span>
					</p>
				</section>
			</div>
		</section>
	</article>
</MainLayout>
