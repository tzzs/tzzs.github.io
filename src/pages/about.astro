---
// 关于页（Positivus 风格）：大标题「关于」+ 自我介绍 / 技术栈 / 我的项目 / GitHub 主页
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE } from '../consts';
import { projects } from '../data/projects';

const githubUrl = 'https://github.com/tzzs';
const techStack = ['Java', 'C', 'Python', 'Go', 'Linux', '数据库'];
---

<MainLayout
	title={`关于 - ${SITE_TITLE}`}
	description="TZZ 的个人简介：技术方向、正在参与的项目与开源主页"
>
	<article class="py-12 md:py-16">
		<header>
			<h1 class="text-5xl font-medium leading-none md:text-7xl">
				关于<span class="ml-3 inline-block rounded-2xl bg-green px-3 py-1">我</span>
			</h1>
			<p class="mt-7 max-w-2xl text-lg leading-relaxed text-[var(--text-soft)]">
				你好，我是 <strong class="font-bold text-[var(--text)]">TZZ</strong>，
				独立开发者，平时做点开发工具，写写技术博客。
			</p>
		</header>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1">自我</span>介绍
			</h2>
			<div class="mt-6 max-w-3xl text-base leading-relaxed">
				<p>
					一名热爱技术的独立开发者。正在做的项目可以在下方「我的项目」中查看，
					或前往 <a class="font-medium text-accent underline-offset-4 hover:underline" href="/projects/">项目列表页</a>。
				</p>
			</div>
		</section>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1">技术</span>栈
			</h2>
			<ul class="tag-list mt-6">
				{
					techStack.map((tech) => (
						<li>
							<span class="tag-pill px-3.5 py-1.5 text-sm">{tech}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1">我的</span>项目
			</h2>
			<p class="mt-6 max-w-3xl text-base leading-relaxed text-[var(--text-soft)]">
				以下是我参与的项目，欢迎关注
				<a class="font-medium text-accent underline-offset-4 hover:underline" href="/projects/">项目列表页</a>
				获取最新进展：
			</p>
			<div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
				{projects.map((project) => <ProjectCard project={project} showCategory />)}
			</div>
		</section>

		<section class="mt-14">
			<h2 class="text-2xl font-medium md:text-3xl">
				<span class="rounded-xl bg-green px-2.5 py-1">开源</span>主页
			</h2>
			<p class="mt-6 max-w-3xl text-base leading-relaxed text-[var(--text-soft)]">
				我的开源项目托管在 GitHub：
				<a class="font-medium text-accent underline-offset-4 hover:underline" href={githubUrl} rel="noopener noreferrer" target="_blank">{githubUrl}</a>
			</p>
			<a class="btn-secondary mt-7" href={githubUrl} rel="noopener noreferrer" target="_blank">
				访问 GitHub 主页
			</a>
		</section>
	</article>
</MainLayout>
