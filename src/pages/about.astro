---
// 关于页：自我介绍 / 技术栈 / 正在开发的应用 / GitHub 主页
import SidebarLayout from '../layouts/SidebarLayout.astro';
import { SITE_TITLE } from '../consts';
import { apps } from '../data/apps';

const githubUrl = 'https://github.com/tzzs';

const statusLabel: Record<string, string> = {
	development: '开发中',
	beta: '测试中',
	released: '已发布',
};
---

<SidebarLayout
	title={`关于 - ${SITE_TITLE}`}
	description="TZZ 的个人简介：技术方向、正在开发的应用与开源主页"
>
	<article class="about">
		<header class="about-header">
			<h1>关于我</h1>
			<p class="lead">
				你好，我是 <strong>TZZ</strong>，{SITE_TITLE} 的开发者与维护者。
			</p>
		</header>

		<section class="block">
			<h2>自我介绍</h2>
			<p>
				一名热爱技术的独立开发者，主要使用 <strong>Java、C、Python、Go</strong> 进行开发，
				日常在 <strong>Linux</strong> 环境下工作，关注<strong>数据库</strong>设计与优化。
				相信小而精的工具能带来更好的体验，喜欢把想法做成真正可用的产品，
				并在这里记录开发过程中的经验与思考。
			</p>
			<p>
				本站既是个人主页，也是产品展示与技术博客：在 <a href="/apps/">应用</a> 栏目
				可以看到我正在开发的产品，在 <a href="/blog/">博客</a> 栏目可以阅读技术文章。
			</p>
		</section>

		<section class="block">
			<h2>技术栈</h2>
			<ul class="chip-list">
				<li>Java</li>
				<li>C</li>
				<li>Python</li>
				<li>Go</li>
				<li>Linux</li>
				<li>数据库</li>
			</ul>
		</section>

		<section class="block">
			<h2>正在开发的应用</h2>
			<p>以下应用正在开发中，欢迎关注 <a href="/apps/">应用列表页</a> 获取最新进展：</p>
			<div class="apps">
				{
					apps.map((app) => (
						<a class="app-item" href={`/apps/${app.slug}/`}>
							<div class="app-head">
								<h3>{app.name}</h3>
								<span class:list={['badge', `badge-${app.status}`]}>
									{statusLabel[app.status] ?? app.status}
								</span>
							</div>
							<p class="app-desc">{app.description}</p>
							<div class="app-platforms">
								{app.platforms.map((p) => (
									<span class="platform">{p}</span>
								))}
							</div>
						</a>
					))
				}
			</div>
		</section>

		<section class="block">
			<h2>开源与社区</h2>
			<p>
				我的开源项目托管在 GitHub：
				<a href={githubUrl} rel="noopener noreferrer" target="_blank">{githubUrl}</a>
			</p>
		</section>
	</article>
</SidebarLayout>

<style>
	.about-header h1 {
		margin-top: 0;
	}
	.lead {
		font-size: 1.05rem;
		color: var(--text-soft);
	}
	.block {
		margin-top: var(--space-6);
	}
	.block h2 {
		margin-top: 0;
	}

	.chip-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.chip-list li {
		padding: 1px 12px;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.88rem;
		color: var(--text-soft);
		background: var(--bg-soft);
	}

	.apps {
		display: grid;
		gap: var(--space-4);
	}
	.app-item {
		display: block;
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.app-item:hover {
		border-color: var(--border-strong);
		box-shadow: var(--shadow);
		text-decoration: none;
	}
	.app-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-3);
	}
	.app-head h3 {
		margin: 0;
		font-size: 1.15rem;
	}
	.app-item:hover h3 {
		color: var(--accent);
	}
	.app-desc {
		margin: var(--space-3) 0 0;
		color: var(--text-soft);
		font-size: 0.95rem;
	}
	.app-platforms {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-3);
	}
</style>
