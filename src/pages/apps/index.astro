---
// 应用列表页：标题「应用」+ 每个应用渲染为卡片（名称/描述/状态徽章/平台），链接到 /apps/[slug]/
import MainLayout from '../../layouts/MainLayout.astro';
import AppCard from '../../components/AppCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { apps } from '../../data/apps';
import { SITE_TITLE } from '../../consts';

// 应用网格列数自适应：优先选能整除应用数的列数，保证每行排满、无悬空卡片（4 个 → 2×2，6 个 → 3×2）
const cols = apps.length === 1 ? 1 : [3, 2].find((c) => apps.length % c === 0) ?? 3;
const gridClass = cols === 3 ? 'md:grid-cols-3' : cols === 2 ? 'md:grid-cols-2' : '';
---

<MainLayout
	title={`应用 - ${SITE_TITLE}`}
	description="TZZ 已发布的应用：VS Code 扩展与 Windows 桌面工具，覆盖开发效率与日常使用。"
>
	<PageHeader
		title="应用"
		badge="Apps"
		description="这里展示我已发布的产品，欢迎下载使用或持续关注进展。"
	/>

	{
		apps.length > 0 ? (
			<div class={`grid gap-6 ${gridClass}`}>
				{apps.map((app) => <AppCard app={app} />)}
			</div>
		) : (
			<p class="py-8 text-text-faint">暂无应用，敬请期待。</p>
		)
	}
</MainLayout>
