---
// 应用列表页：标题「应用」+ 每个应用渲染为卡片（名称/描述/状态徽章/平台），链接到 /apps/[slug]/
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import AppCard from '../../components/AppCard.astro';
import { apps } from '../../data/apps';
import { SITE_TITLE } from '../../consts';
---

<SidebarLayout
	title={`应用 - ${SITE_TITLE}`}
	description="TZZ 正在开发的应用：AI Diary、LUT Studio、Markdown Editor 等产品的进展与下载"
>
	<article class="apps-page">
		<header class="page-header">
			<h1>应用</h1>
			<p class="page-desc">
				这里展示我正在开发的产品。当前均处于开发阶段，欢迎持续关注进展。
			</p>
		</header>

		{
			apps.length > 0 ? (
				<div class="app-grid">
					{apps.map((app) => <AppCard app={app} />)}
				</div>
			) : (
				<p class="empty">暂无应用，敬请期待。</p>
			)
		}
	</article>
</SidebarLayout>

<style>
	.page-header h1 {
		margin: 0 0 var(--space-2);
	}
	.page-desc {
		margin: 0 0 var(--space-6);
		color: var(--text-soft);
	}
	.app-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--space-4);
	}
	.empty {
		color: var(--text-faint);
	}
</style>
