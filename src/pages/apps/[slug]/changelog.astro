---
// 应用更新日志页：渲染 src/content/apps/<slug>/changelog.md
// 未知 slug 不在此生成（getStaticPaths 仅来自 apps 数组），返回 404；
// 已知应用但 changelog.md 缺失时优雅降级为占位提示。
import { getCollection, render } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import { apps, type App } from '../../../data/apps';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	return apps.map((app) => ({
		params: { slug: app.slug },
		props: { app },
	}));
}

interface Props {
	app: App;
}

const { app } = Astro.props;

const entry = (await getCollection('apps')).find(
	(entry) => entry.id === `${app.slug}/changelog`,
);
const ChangelogContent = entry ? (await render(entry)).Content : undefined;
const pageTitle = entry?.data.title ?? '更新日志';
const pubDate = entry?.data.pubDate;
const dateText = pubDate
	? pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
	: undefined;
---

<MainLayout
	title={`${pageTitle} - ${app.name} - ${SITE_TITLE}`}
	description={`${app.name} 的更新日志`}
>
	<article>
		<!-- 面包屑：返回应用详情页 -->
		<nav class="mb-6" aria-label="面包屑">
			<a
				class="text-sm font-medium text-text-soft transition-colors duration-150 hover:text-accent"
				href={`/apps/${app.slug}/`}
			>
				&larr; {app.name}
			</a>
		</nav>

		<header class="mb-8 border-b border-border pb-5">
			<h1 class="text-3xl font-bold tracking-tight md:text-4xl">{pageTitle}</h1>
			{dateText && <p class="mt-2 text-sm text-text-faint">最后更新：{dateText}</p>}
		</header>

		{
			ChangelogContent ? (
				// changelog.md 自带 H1（更新日志），已在页头展示，隐藏正文首个 H1 避免重复
				<div class="prose">
					<ChangelogContent />
				</div>
			) : (
				<p class="text-text-faint">更新日志暂未发布，敬请期待。</p>
			)
		}
	</article>
</MainLayout>

<style>
	/* changelog.md 自带 H1（更新日志），已由页头展示，隐藏正文首个 H1 */
	.prose :global(h1:first-child) {
		display: none;
	}
</style>
