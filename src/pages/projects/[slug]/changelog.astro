---
// 项目更新日志页：渲染 src/content/projects/<slug>/changelog.md
// 仅 app（应用）、extension（VS Code 插件）分类生成（getStaticPaths 按 category 过滤）；
// 未知 slug 或 agent-tool/skill 分类不在此生成，返回 404；
// 已知项目但 changelog.md 缺失时优雅降级为占位提示。
import { getCollection, render } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import { projects, type Project } from '../../../data/projects';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	return projects
		.filter((project) => project.category === 'app' || project.category === 'extension')
		.map((project) => ({
			params: { slug: project.slug },
			props: { project },
		}));
}

interface Props {
	project: Project;
}

const { project } = Astro.props;

const entry = (await getCollection('projects')).find(
	(entry) => entry.id === `${project.slug}/changelog`,
);
const ChangelogContent = entry ? (await render(entry)).Content : undefined;
const pageTitle = entry?.data.title ?? '更新日志';
const pubDate = entry?.data.pubDate;
const dateText = pubDate
	? pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
	: undefined;
---

<MainLayout
	title={`${pageTitle} - ${project.name} - ${SITE_TITLE}`}
	description={`${project.name} 的更新日志`}
>
	<article>
		<!-- 面包屑：返回项目详情页 -->
		<nav class="mb-6" aria-label="面包屑">
			<a
				class="text-sm font-medium text-text-soft transition-colors duration-150 hover:text-accent"
				href={`/projects/${project.slug}/`}
			>
				&larr; {project.name}
			</a>
		</nav>

		<header class="mb-8 border-b border-border pb-5">
			<h1 class="text-3xl font-bold tracking-tight md:text-4xl">{pageTitle}</h1>
			{dateText && <p class="mt-2 text-sm text-text-faint">最后更新：{dateText}</p>}
		</header>

		{
			ChangelogContent ? (
				// changelog.md 自带 H1（更新日志），已在页头展示，隐藏正文首个 H1 避免重复
				<div class="prose">
					<ChangelogContent />
				</div>
			) : (
				<p class="text-text-faint">更新日志暂未发布，敬请期待。</p>
			)
		}
	</article>
</MainLayout>

<style>
	/* changelog.md 自带 H1（更新日志），已由页头展示，隐藏正文首个 H1 */
	.prose :global(h1:first-child) {
		display: none;
	}
</style>
