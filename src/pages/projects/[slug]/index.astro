---
// 项目详情页：Hero（名称/描述/状态徽章/分类/平台）→ 项目介绍（index.md）→ 获取方式 → 子页导航（仅 app/extension 分类）
// 未知 slug 不在此生成（未出现在 getStaticPaths 中），由站点返回 404；
// 已知项目但内容缺失时优雅降级为占位提示。
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../../../layouts/MainLayout.astro';
import LinkIcon from '../../../components/LinkIcon.astro';
import { projects, CATEGORY_LABELS, type Project, type ProjectStatus } from '../../../data/projects';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

interface Props {
	project: Project;
}

const { project } = Astro.props;

// changelog/privacy 子页仅 app（应用）、extension（VS Code 插件）分类生成；agent-tool/skill 类开源项目的
// 更新日志与隐私说明以 GitHub 仓库为准，站内不重复维护
const hasSubPages = project.category === 'app' || project.category === 'extension';

const statusLabels: Record<ProjectStatus, string> = {
	development: '开发中',
	beta: '测试中',
	released: '已发布',
};

// 链接标签：优先展示中文可读文案，未知 key 回退为原 key
const linkLabels: Record<string, string> = {
	appStore: 'App Store',
	googlePlay: 'Google Play',
	web: '网页版',
	online: '在线版',
	windows: 'Windows 版',
	macos: 'macOS 版',
	ios: 'iOS 版',
	android: 'Android 版',
	github: 'GitHub 仓库',
	npm: 'npm 包',
	download: '下载安装包',
	official: '官网下载',
	marketplace: 'VS Code 扩展市场',
	openVsx: 'Open VSX',
};
const labelFor = (key: string) => linkLabels[key] ?? key;

const linkEntries = Object.entries(project.links ?? {});

// 主链接：projects.ts 中 links 的第一个即主渠道（如 marketplace / npm），作为 Hero 主 CTA
const primaryLink = linkEntries[0];
const githubUrl = project.links?.github;

// 判断链接是否为下载类（安装包直链），决定图标（⬇ 下载 / ↗ 外部）
const isDownloadUrl = (key: string, url: string) =>
	key === 'download' || /\.(exe|msi|zip|vsix|dmg|apk)$/i.test(url);

// 项目介绍：src/content/projects/<slug>/index.md
// Astro 7 glob loader：entry.id = slug（文件名去扩展名，且尾部 /index 被移除）
const introEntry = (await getCollection('projects')).find(
	(entry) => entry.id === project.slug,
);
const IntroContent = introEntry ? (await render(introEntry)).Content : undefined;
---

<MainLayout title={`${project.name} - ${SITE_TITLE}`} description={project.description}>
	<article>
		<!-- Hero：图标 + 名称 + 描述 + 状态徽章 + 分类/平台 + 获取入口（底部收紧，衔接项目介绍） -->
		<header class="pt-10 pb-6 md:pt-12 md:pb-8">
			<h1 class="flex items-center gap-4 text-3xl font-bold tracking-tight md:text-4xl">
				{
					project.icon && (
						<Image
							class="h-12 w-12 shrink-0 rounded-xl"
							src={project.icon}
							alt={`${project.name} 图标`}
							width={48}
							height={48}
							loading="eager"
							decoding="async"
						/>
					)
				}
				{project.name}
			</h1>
			<p class="mt-3 max-w-[42em] text-lg leading-relaxed text-text-soft">
				{project.description}
			</p>
			<div class="mt-5 flex flex-wrap items-center gap-3">
				<span
					class:list={['badge', `badge-${project.status}`]}
					data-i18n-key={`status.${project.status}`}
				>
					{statusLabels[project.status] ?? project.status}
				</span>
				<span class="text-sm text-text-faint">
					<span data-i18n-key={`category.${project.category}`}>{CATEGORY_LABELS[project.category]}</span> · {project.platforms.join(' / ')}
				</span>
			</div>
			{
				/* 主 CTA：第一眼直达主渠道（主链接绿色实底 + GitHub 白底次按钮），获取方式区保留完整列表 */
				primaryLink && (
					<div class="mt-7 flex flex-wrap items-center gap-3">
						{/* 主 CTA：绿色实底（对比用），hover 反色 */}
						<a
							class="btn-tertiary group px-4 py-2 text-sm"
							href={primaryLink[1]}
							target="_blank"
							rel="noopener noreferrer"
						>
							<span data-i18n-key={`link.${primaryLink[0]}`}>{labelFor(primaryLink[0])}</span>
							<LinkIcon download={isDownloadUrl(primaryLink[0], primaryLink[1])} />
						</a>
						{
							/* 主链接已是 GitHub 时不重复展示次按钮 */
							githubUrl && primaryLink[0] !== 'github' && (
								<a
									class="btn-tertiary group px-4 py-2 text-sm"
									href={githubUrl}
									target="_blank"
									rel="noopener noreferrer"
								>
									{/* 次 CTA：绿色实底（与主按钮同款，对比用） */}
									<span data-i18n-key="link.github">GitHub 仓库</span>
									<LinkIcon />
								</a>
							)
						}
					</div>
				)
			}
		</header>

		<!-- 项目介绍：渲染 index.md -->
		<section class="mt-5" aria-labelledby="intro-heading">
			<h2
				id="intro-heading"
				class="mb-6 border-b border-border pb-3 text-2xl font-bold tracking-tight"
				data-i18n-key="project.introHeading"
			>
				项目介绍
			</h2>
			{
				IntroContent ? (
					// index.md 自带一级标题（项目名），Hero 已展示，故隐藏正文首个 H1 避免重复
					<div class="prose">
						<IntroContent />
					</div>
				) : (
					<p class="text-text-faint" data-i18n-key="project.introPlaceholder">该项目的介绍即将上线，敬请期待。</p>
				)
			}
		</section>

		<!-- 获取方式：project.links 渲染为胶囊按钮（下载 ⬇ / 外部 ↗），主渠道已作为 Hero 主 CTA -->
		<section class="mt-10" aria-labelledby="links-heading">
			<h2
				id="links-heading"
				class="mb-6 border-b border-border pb-3 text-2xl font-bold tracking-tight"
				data-i18n-key="project.linksHeading"
			>
				获取方式
			</h2>
			{
				linkEntries.length > 0 ? (
					/* 链接列表：绿色实底迷你按钮，与 Hero CTA 同款样式 */
					<ul class="flex flex-wrap gap-3">
						{linkEntries.map(([key, url]) => (
							<li>
								<a
									class="btn-tertiary group px-4 py-2 text-sm"
									href={url}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span data-i18n-key={`link.${key}`}>{labelFor(key)}</span>
									<LinkIcon download={isDownloadUrl(key, url)} />
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="text-text-faint" data-i18n-key="project.linksPlaceholder">敬请期待</p>
				)
			}
		</section>

		{
			/* 子页导航：更新日志 + 隐私政策（卡片式链接 + 圆形箭头按钮，明确可点击），仅 app/extension 分类生成 */
			hasSubPages && (
				<nav class="mt-10 grid gap-6 md:grid-cols-2" aria-label={`${project.name} 子页面导航`}>
					<a
						class="group flex items-center justify-between gap-4 rounded-[var(--radius-card)] border border-[var(--border)] bg-bg p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)] hover:shadow-[var(--shadow)]"
						href={`/projects/${project.slug}/changelog/`}
					>
						<span class="min-w-0">
							<span
								class="block font-semibold text-text transition-colors duration-200 group-hover:text-accent"
								data-i18n-key="project.changelogTitle"
							>
								更新日志
							</span>
							<span class="mt-0.5 block text-sm text-text-faint" data-i18n-key="project.changelogDesc">版本记录与变更说明</span>
						</span>
						<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-green text-black transition-colors duration-200 group-hover:bg-black group-hover:text-green">
							<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" />
							</svg>
						</span>
					</a>
					<a
						class="group flex items-center justify-between gap-4 rounded-[var(--radius-card)] border border-[var(--border)] bg-bg p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)] hover:shadow-[var(--shadow)]"
						href={`/projects/${project.slug}/privacy/`}
					>
						<span class="min-w-0">
							<span
								class="block font-semibold text-text transition-colors duration-200 group-hover:text-accent"
								data-i18n-key="project.privacyTitle"
							>
								隐私政策
							</span>
							<span class="mt-0.5 block text-sm text-text-faint" data-i18n-key="project.privacyDesc">数据收集与使用说明</span>
						</span>
						<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-green text-black transition-colors duration-200 group-hover:bg-black group-hover:text-green">
							<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" />
							</svg>
						</span>
					</a>
				</nav>
			)
		}
	</article>
</MainLayout>

<style>
	/* index.md 自带 H1（项目名），Hero 已展示，隐藏正文首个 H1 避免重复 */
	.prose :global(h1:first-child) {
		display: none;
	}
</style>
