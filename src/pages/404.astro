---
// 404 页（Positivus 风格）：大号描边「404」+ 文案「页面不存在」+ 返回首页 / 浏览项目 / 阅读博客
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_TITLE } from '../consts';
---

<MainLayout
	title={`页面不存在 - ${SITE_TITLE}`}
	description="您访问的页面不存在，请返回首页或浏览其他栏目"
>
	<section class="flex min-h-[65vh] flex-col items-center justify-center py-20 text-center">
		<p class="font-outline text-[7rem] leading-none text-white select-none md:text-[10rem]" aria-hidden="true">
			404
		</p>
		<h1 class="mt-6 text-3xl font-medium md:text-4xl">
			<span class="inline-block rounded-2xl bg-green px-4 py-1" data-i18n-key="404.title">页面不存在</span>
		</h1>
		<p class="mt-5 max-w-md leading-relaxed text-[var(--text-soft)]" data-i18n-key="404.desc">
			您访问的页面可能已被移除、改名，或地址输入有误。
		</p>
		<div class="mt-9 flex flex-wrap items-center justify-center gap-4">
			<a class="btn-primary" href="/" data-i18n-key="404.ctaHome">返回首页</a>
			<a class="btn-secondary" href="/projects/" data-i18n-key="404.ctaProjects">浏览项目</a>
			<a class="btn-secondary" href="/blog/" data-i18n-key="home.ctaReadBlog">阅读博客</a>
		</div>
	</section>
</MainLayout>
