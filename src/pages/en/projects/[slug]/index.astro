---
// 项目详情页英文版：/en/projects/<slug>/，与 src/pages/projects/[slug]/index.astro 结构一致，
// 唯一的结构性差异是省略了底部「更新日志/隐私政策」子页导航——那两个子页本身不在双语范围内，
// 不应该从英文页面链接过去一个突然变成中文的页面。
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../../../../layouts/MainLayout.astro';
import LinkIcon from '../../../../components/LinkIcon.astro';
import { CATEGORY_LABELS, getProjectStaticPaths, type Project, type ProjectStatus } from '../../../../data/projects';
import { SITE_TITLE } from '../../../../consts';
import { resolveLocale, t } from '../../../../i18n/strings';

export async function getStaticPaths() {
	return getProjectStaticPaths();
}

interface Props {
	project: Project;
}

const { project } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);

const statusLabels: Record<ProjectStatus, string> = {
	development: '开发中',
	beta: '测试中',
	released: '已发布',
};

const linkLabels: Record<string, string> = {
	appStore: 'App Store',
	googlePlay: 'Google Play',
	web: '网页版',
	online: '在线版',
	windows: 'Windows 版',
	macos: 'macOS 版',
	ios: 'iOS 版',
	android: 'Android 版',
	github: 'GitHub 仓库',
	npm: 'npm 包',
	download: '下载安装包',
	official: '官网下载',
	marketplace: 'VS Code 扩展市场',
	openVsx: 'Open VSX',
};
const labelFor = (key: string) => t(locale, `link.${key}`, linkLabels[key] ?? key);

const linkEntries = Object.entries(project.links ?? {});
const primaryLink = linkEntries[0];
const githubUrl = project.links?.github;

const isDownloadUrl = (key: string, url: string) =>
	key === 'download' || /\.(exe|msi|zip|vsix|dmg|apk)$/i.test(url);

const introEntry = (await getCollection('projects')).find(
	(entry) => entry.id === project.slug,
);
const IntroContent = introEntry ? (await render(introEntry)).Content : undefined;

const name = t(locale, `project.${project.slug}.name`, project.name);
const description = t(locale, `project.${project.slug}.description`, project.description);
---

<MainLayout title={`${name} - ${SITE_TITLE}`} description={description}>
	<article>
		<!-- Hero：图标 + 名称 + 描述 + 状态徽章 + 分类/平台 + 获取入口（底部收紧，衔接项目介绍） -->
		<header class="pt-10 pb-6 md:pt-12 md:pb-8">
			<h1 class="flex items-center gap-4 text-3xl font-bold tracking-tight md:text-4xl">
				{
					project.icon && (
						<Image
							class="h-12 w-12 shrink-0 rounded-xl"
							src={project.icon}
							alt={`${name} icon`}
							width={48}
							height={48}
							loading="eager"
							decoding="async"
						/>
					)
				}
				<span>{name}</span>
			</h1>
			<p class="mt-3 max-w-[42em] text-lg leading-relaxed text-text-soft">
				{description}
			</p>
			<div class="mt-5 flex flex-wrap items-center gap-3">
				<span class:list={['badge', `badge-${project.status}`]}>
					{t(locale, `status.${project.status}`, statusLabels[project.status] ?? project.status)}
				</span>
				<span class="text-sm text-text-faint">
					<span>{t(locale, `category.${project.category}`, CATEGORY_LABELS[project.category])}</span> · {project.platforms.join(' / ')}
				</span>
			</div>
			{
				primaryLink && (
					<div class="mt-7 flex flex-wrap items-center gap-3">
						<a
							class="btn-tertiary group px-4 py-2 text-sm"
							href={primaryLink[1]}
							target="_blank"
							rel="noopener noreferrer"
						>
							<span>{labelFor(primaryLink[0])}</span>
							<LinkIcon download={isDownloadUrl(primaryLink[0], primaryLink[1])} />
						</a>
						{
							githubUrl && primaryLink[0] !== 'github' && (
								<a
									class="btn-tertiary group px-4 py-2 text-sm"
									href={githubUrl}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span>{t(locale, 'link.github', 'GitHub 仓库')}</span>
									<LinkIcon />
								</a>
							)
						}
					</div>
				)
			}
		</header>

		<!-- 项目介绍：渲染 index.md（正文本身不在双语范围内，找不到译文时英文页面会直接展示中文正文） -->
		<section class="mt-5" aria-labelledby="intro-heading">
			<h2
				id="intro-heading"
				class="mb-6 border-b border-border pb-3 text-2xl font-bold tracking-tight"
			>
				{t(locale, 'project.introHeading', '项目介绍')}
			</h2>
			{
				IntroContent ? (
					<div class="prose">
						<IntroContent />
					</div>
				) : (
					<p class="text-text-faint">{t(locale, 'project.introPlaceholder', '该项目的介绍即将上线，敬请期待。')}</p>
				)
			}
		</section>

		<!-- 获取方式：project.links 渲染为胶囊按钮（下载 ⬇ / 外部 ↗），主渠道已作为 Hero 主 CTA -->
		<section class="mt-10" aria-labelledby="links-heading">
			<h2
				id="links-heading"
				class="mb-6 border-b border-border pb-3 text-2xl font-bold tracking-tight"
			>
				{t(locale, 'project.linksHeading', '获取方式')}
			</h2>
			{
				linkEntries.length > 0 ? (
					<ul class="flex flex-wrap gap-3">
						{linkEntries.map(([key, url]) => (
							<li>
								<a
									class="btn-tertiary group px-4 py-2 text-sm"
									href={url}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span>{labelFor(key)}</span>
									<LinkIcon download={isDownloadUrl(key, url)} />
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="text-text-faint">{t(locale, 'project.linksPlaceholder', '敬请期待')}</p>
				)
			}
		</section>
	</article>
</MainLayout>

<style>
	/* index.md 自带 H1（项目名），Hero 已展示，隐藏正文首个 H1 避免重复 */
	.prose :global(h1:first-child) {
		display: none;
	}
</style>
