---
// 项目列表页英文版：/en/projects/，与 src/pages/projects/index.astro 结构完全一致
import MainLayout from '../../../layouts/MainLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { projects, CATEGORY_LABELS, CATEGORY_ORDER } from '../../../data/projects';
import { SITE_TITLE } from '../../../consts';
import { resolveLocale, t } from '../../../i18n/strings';

const locale = resolveLocale(Astro.currentLocale);

const groups = CATEGORY_ORDER.map((category) => ({
	category,
	items: projects.filter((project) => project.category === category),
})).filter((group) => group.items.length > 0);
---

<MainLayout
	title={`Projects - ${SITE_TITLE}`}
	description="TZZ's projects: VS Code extensions, desktop apps, Agent tools and Skills, covering dev productivity and everyday use."
>
	<PageHeader
		titleHighlight={t(locale, 'projectsPage.title', '项目')}
		description={t(locale, 'projectsPage.description', '这里展示我做的项目，涵盖应用、VS Code 插件、Agent 工具与 Skill，欢迎使用或持续关注进展。')}
	/>

	{
		groups.length > 0 ? (
			<div class="flex flex-col gap-14">
				{groups.map((group) => (
					<section aria-labelledby={`category-${group.category}-heading`}>
						<h2
							id={`category-${group.category}-heading`}
							class="mb-6 text-2xl font-bold tracking-tight"
						>
							{t(locale, `category.${group.category}`, CATEGORY_LABELS[group.category])}
						</h2>
						<div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
							{
								group.items.map((project, index) => (
									<ProjectCard project={project} featured={index === 0} />
								))
							}
						</div>
					</section>
				))}
			</div>
		) : (
			<p class="py-8 text-text-faint">{t(locale, 'home.emptyProjects', '暂无项目，敬请期待。')}</p>
		)
	}
</MainLayout>
