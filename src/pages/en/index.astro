---
// 门户首页英文版（Positivus 落地页风格）：/en/，与 src/pages/index.astro 结构完全一致，
// 只是每处文案都经过 t() 解析成英文。数据获取逻辑原样复制（页面级、无 getStaticPaths 风险）。
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { projects } from '../../data/projects';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { resolveLocale, t } from '../../i18n/strings';

const locale = resolveLocale(Astro.currentLocale);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = allPosts.slice(0, 5);
const postCount = allPosts.length;

const cols = projects.length === 1 ? 1 : [3, 2].find((c) => projects.length % c === 0) ?? 3;
const gridClass = cols === 3 ? 'md:grid-cols-3' : cols === 2 ? 'md:grid-cols-2' : '';

// 目前字典没有覆盖这份数组（原版也是直接写死在页面里，不是字典漏了），直接手写英文
const techStack = ['VS Code Extensions', 'Windows Desktop', 'Java', 'Spring', 'Vue', 'Go', 'TypeScript'];

const formatDate = (d: Date) => {
	const y = d.getFullYear();
	const m = String(d.getMonth() + 1).padStart(2, '0');
	const day = String(d.getDate()).padStart(2, '0');
	return `${y}-${m}-${day}`;
};

const blogHref = getRelativeLocaleUrl(locale, 'blog');
const projectsHref = getRelativeLocaleUrl(locale, 'projects');
const aboutHref = getRelativeLocaleUrl(locale, 'about');
---

<MainLayout title={SITE_TITLE} description={t(locale, 'home.heroTagline', SITE_DESCRIPTION)} image="/images/logo.png">
	<!-- ===== Hero ===== -->
	<section class="flex flex-col gap-12 py-12 sm:py-20 lg:flex-row lg:items-center lg:gap-16">
		<div class="flex-1">
			<p class="mb-6 w-fit rounded-lg bg-green px-3 py-1.5 text-sm font-medium text-black">
				{t(locale, 'home.independentDeveloper', '独立开发者')}
			</p>
			<h1 class="text-5xl font-medium leading-[1.05] sm:text-6xl xl:text-7xl">
				TZZ'S <span class="font-outline-sm text-transparent">BLOG</span>
			</h1>
			<p class="mt-6 max-w-xl text-lg leading-relaxed text-text-soft lg:text-xl">
				{t(locale, 'home.heroTagline', 'TZZ 的独立开发者主页：应用开发与技术实践。')}
			</p>
			<div class="mt-9 flex flex-wrap gap-4">
				<a class="btn-tertiary" href={projectsHref}>{t(locale, 'home.ctaViewProjects', '查看项目')}</a>
				<a class="btn-secondary" href={blogHref}>{t(locale, 'home.ctaReadBlog', '阅读博客')}</a>
			</div>
		</div>
		<div class="hidden flex-1 justify-center lg:flex">
			<div
class="w-full max-w-sm overflow-hidden rounded-[2rem] border border-white/10 bg-dark shadow-[0_24px_48px_-12px_rgba(0,0,0,0.5)]"
			>
			<div
				class="flex items-center gap-2 border-b border-white/10 bg-black/40 px-5 py-3.5"
			>
				<span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
				<span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
				<span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
				<span class="ml-3 font-mono text-xs text-white/50">tzzs@portal · zsh</span>
			</div>
			<div class="space-y-4 px-6 py-7 font-mono text-sm">
				<div class="terminal-line">
					<p><span class="text-green">➜</span> <span class="text-white/80">~</span> <span class="text-white/80">whoami</span></p>
					<p class="mt-1 text-5xl font-bold text-green">TZZ</p>
				</div>
				<div class="terminal-line">
					<p><span class="text-green">➜</span> <span class="text-white/80">~</span> <span class="text-white/80">role</span></p>
					<p class="mt-1 text-white/90">{t(locale, 'home.independentDeveloper', '独立开发者')}</p>
				</div>
				<div class="terminal-line">
					<p><span class="text-green">➜</span> <span class="text-white/80">~</span> <span class="text-white/80">stack</span></p>
					<p class="mt-1">
						<span
							class="inline-block rounded-md border border-green/40 bg-green/10 px-2 py-0.5 text-xs text-green"
						>
							AI
						</span>
					</p>
				</div>
				<p class="terminal-line text-white/40">
					<span class="text-green">➜</span> <span class="text-white/80">~</span> <span class="inline-block h-4 w-2 animate-pulse bg-green/80 align-middle"></span>
				</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ===== 项目区 ===== -->
	<section aria-labelledby="projects-heading" class="mt-16 sm:mt-24">
		<div class="mb-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-10">
			<h2
				id="projects-heading"
				class="w-fit shrink-0 rounded-lg bg-green px-2.5 py-1.5 text-3xl font-medium text-black sm:text-4xl"
			>
				{t(locale, 'home.projectsHeading', '正在进行的项目')}
			</h2>
			<p class="text-text-soft sm:max-w-[560px]">
				{t(locale, 'home.projectsDescPrefix', '目前维护')}
				{' '}{projects.length}{' '}
				{t(locale, 'home.projectsDescSuffix', '个项目，覆盖 VS Code 插件、桌面工具、Agent 工具与 Skills，更多正在开发中。')}
			</p>
		</div>
		{
			projects.length > 0 ? (
				<div class={`grid gap-6 ${gridClass}`}>
					{projects.map((project) => <ProjectCard project={project} showCategory />)}
				</div>
			) : (
				<p class="rounded-2xl border border-dashed border-border px-6 py-12 text-center text-text-faint">
					{t(locale, 'home.emptyProjects', '暂无项目，敬请期待。')}
				</p>
			)
		}
		{
			projects.length > 0 && (
				<div class="mt-10 text-center">
					<a
					class="group inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-6 py-2.5 text-sm font-medium text-[var(--text-soft)] transition-colors duration-200 hover:border-[var(--accent)] hover:text-[var(--accent)]"
					href={projectsHref}
				>
					{t(locale, 'home.viewAllProjects', '查看全部项目')}
					<svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" />
					</svg>
				</a>
				</div>
			)
		}
	</section>

	<!-- ===== 博客区 ===== -->
	<section aria-labelledby="blog-heading" class="mt-16 sm:mt-24">
		<div class="mb-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-10">
			<h2
				id="blog-heading"
				class="w-fit shrink-0 rounded-lg bg-green px-2.5 py-1.5 text-3xl font-medium text-black sm:text-4xl"
			>
				{t(locale, 'home.blogHeading', '最近文章')}
			</h2>
			<p class="text-text-soft sm:max-w-[560px]">
				{t(locale, 'home.blogDesc', '记录编程路上的思考与经验：踩坑记录、设计与工程实践。')}
			</p>
		</div>
		{
			recentPosts.length > 0 ? (
				/* 分隔列表式：与上方应用卡片网格形成节奏对比（日期 + 标题 + 摘要）；文章正文不在双语范围内，
				   链接保持不带 locale 前缀，直接指向中文详情页 */
				<div class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--bg)]">
					<div class="divide-y divide-[var(--border)]">
						{
							recentPosts.map((post) => (
								<a
									href={`/blog/${post.id}/`}
									class="group flex flex-col gap-1.5 px-6 py-5 transition-colors duration-150 hover:bg-[var(--bg-soft)] sm:flex-row sm:items-baseline sm:gap-6"
								>
									<time
										class="shrink-0 font-mono text-sm text-[var(--text-faint)] tabular-nums"
										datetime={post.data.pubDate.toISOString()}
									>
										{formatDate(post.data.pubDate)}
									</time>
									<span class="min-w-0 flex-1">
										<span
											class="block font-semibold text-[var(--text)] transition-colors duration-150 group-hover:text-[var(--accent)]"
										>
											{post.data.title}
										</span>
										{
											post.data.description && (
												<span class="mt-0.5 block truncate text-sm text-[var(--text-soft)]">
													{post.data.description}
												</span>
											)
										}
									</span>
								</a>
							))
						}
					</div>
				</div>
			) : (
				<p class="rounded-2xl border border-dashed border-border px-6 py-12 text-center text-text-faint">
					{t(locale, 'home.emptyBlog', '还没有文章，敬请期待。')}
				</p>
			)
		}
		{
			recentPosts.length > 0 && (
				<div class="mt-10 text-center">
					<a
					class="group inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-6 py-2.5 text-sm font-medium text-[var(--text-soft)] transition-colors duration-200 hover:border-[var(--accent)] hover:text-[var(--accent)]"
					href={blogHref}
				>
					{t(locale, 'home.viewAllPosts', '查看全部文章')}
					<svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" />
					</svg>
				</a>
				</div>
			)
		}
	</section>

	<!-- ===== 关于开发者 ===== -->
	<section aria-labelledby="about-heading" class="mt-16 sm:mt-24">
		<div
			class="flex flex-col gap-10 rounded-[2rem] bg-black p-8 text-white sm:p-12 lg:flex-row lg:items-start lg:justify-between"
		>
			<div class="max-w-2xl">
				<h2 id="about-heading" class="text-3xl font-bold sm:text-4xl">{t(locale, 'home.aboutHeading', '你好，我是 TZZ')}</h2>
				<p class="mt-4 leading-relaxed text-white/70">
					{t(locale, 'home.aboutDesc', '独立开发者，专注 VS Code 扩展与 Windows 桌面工具，也在博客里记录技术踩坑与工程实践。')}
				</p>
				<ul class="mt-6 flex flex-wrap gap-2" aria-label="Tech Stack">
					{
						techStack.map((tech) => (
							<li class="rounded-full border border-white/20 px-2.5 py-0.5 text-xs text-white/70">
								{tech}
							</li>
						))
					}
				</ul>
			</div>
			<div class="flex shrink-0 flex-col gap-8 lg:items-end">
				<dl class="flex gap-12 lg:flex-col lg:gap-4">
					<div>
						<dt class="text-sm text-white/50">{t(locale, 'home.statBlogPosts', '博客文章')}</dt>
						<dd class="mt-1 font-mono text-3xl font-bold text-green">{postCount}</dd>
					</div>
					<div>
						<dt class="text-sm text-white/50">{t(locale, 'home.statProjects', '项目')}</dt>
						<dd class="mt-1 font-mono text-3xl font-bold text-green">{projects.length}</dd>
					</div>
				</dl>
				<a class="btn-tertiary w-fit" href={aboutHref}>{t(locale, 'home.learnMore', '了解更多 →')}</a>
			</div>
		</div>
	</section>
</MainLayout>
