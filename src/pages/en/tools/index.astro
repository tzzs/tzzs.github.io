---
// 工具列表页英文版：/en/tools/，与 src/pages/tools/index.astro 结构完全一致，
// 只有页头文案与 MainLayout 的 title/description 换成英文。
import MainLayout from '../../../layouts/MainLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ToolCard from '../../../components/tools/ToolCard.astro';
import { tools } from '../../../data/tools';
import { resolveLocale } from '../../../i18n/strings';
import { SITE_TITLE } from '../../../consts';

const locale = resolveLocale(Astro.currentLocale);
---

<MainLayout
	title={`Tools - ${SITE_TITLE}`}
	description="Small online tools by TZZ: track viewer and more, all running entirely in your browser with no uploads."
>
	<PageHeader
		titleHighlight="Tools"
		description="The online tools I've built. Everything runs locally in your browser — your data never leaves this device."
	/>

	{
		tools.length > 0 ? (
			<div class="grid gap-6 pb-12 md:grid-cols-2">
				{tools.map((tool) => (
					<ToolCard tool={tool} locale={locale} />
				))}
			</div>
		) : (
			<p class="py-8 text-text-faint">No tools yet, stay tuned.</p>
		)
	}
</MainLayout>
