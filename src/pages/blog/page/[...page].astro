---
// 博客列表第 2+ 页（/blog/page/2/ ...）。第 1 页在 /blog/（blog/index.astro）。
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import PostList from '../../../components/PostList.astro';
import { SITE_TITLE } from '../../../consts';
import { getBlogPageStaticPaths } from '../../../lib/paginate';

type Props = { page: Page<CollectionEntry<'blog'>> };

export const getStaticPaths = (() => getBlogPageStaticPaths('zh')) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainLayout
	title={`博客 第 ${page.currentPage} 页 | ${SITE_TITLE}`}
	description="TZZ 的技术博客：编程踩坑记录与技术分享"
	hasEnglishVersion
>
	<PostList page={page} />
</MainLayout>
