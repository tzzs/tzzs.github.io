---
// 博客文章详情页
// - 仅生成非草稿文章；草稿不生成页面（访问即 404）
// - 正文中的 [TOC] 标记由 remark-toc-marker 插件在 markdown 渲染阶段
//   替换为文章目录（h1-h3 锚点列表，class="article-toc"），样式已在 global.css
// - katex 公式样式已随 global.css 引入，正文直接渲染即可
import { type CollectionEntry, getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import TagList from '../../components/TagList.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { title, description, pubDate, updated, tags = [], categories = [], cover, author = 'TZZ' } =
	post.data;
const { Content } = await render(post);

// 上一篇 / 下一篇：按 pubDate 降序排序，比当前文章新的是「下一篇」
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const prevPost =
	currentIndex >= 0 && currentIndex < allPosts.length - 1
		? allPosts[currentIndex + 1]
		: undefined;

const dateText = (d: Date) =>
	d.toLocaleDateString('zh-CN', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
---

<MainLayout title={`${title} | ${SITE_TITLE}`} description={description}>
	{/* 面包屑 */}
	<nav class="mb-6 text-sm text-[var(--text-faint)]" aria-label="面包屑">
		<a class="transition-colors duration-150 hover:text-[var(--accent)]" href="/">首页</a>
		<span class="mx-2 text-[var(--border-strong)]">/</span>
		<a class="transition-colors duration-150 hover:text-[var(--accent)]" href="/blog/">博客</a>
		<span class="mx-2 text-[var(--border-strong)]">/</span>
		<span class="text-[var(--text-soft)]">{title}</span>
	</nav>

	<article>
		<header>
			<h1 class="text-4xl font-extrabold leading-tight text-[var(--text)]">{title}</h1>

			{/* 日期 / 作者 / 更新 / 分类 */}
			<div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-[var(--text-faint)]">
				<time datetime={pubDate.toISOString()}>{dateText(pubDate)}</time>
				{author && (
					<>
						<span class="text-[var(--border-strong)]">·</span>
						<span>作者：{author}</span>
					</>
				)}
				{
					updated && (
						<>
							<span class="text-[var(--border-strong)]">·</span>
							<span>
								更新于
								<time datetime={updated.toISOString()}>{dateText(updated)}</time>
							</span>
						</>
					)
				}
				{
					categories.length > 0 && (
						<span class="inline-flex flex-wrap gap-1.5">
							{categories.map((c) => (
								<a
									class="inline-block rounded-full border border-[var(--border)] px-2.5 py-0.5 text-xs text-[var(--text-soft)] no-underline transition-colors duration-150 hover:border-[var(--accent)] hover:text-[var(--accent)]"
									href={`/blog/categories/${encodeURIComponent(c)}/`}
								>
									{c}
								</a>
							))}
						</span>
					)
				}
			</div>

			{
				tags.length > 0 && (
					<div class="mt-4">
						<TagList tags={tags} />
					</div>
				)
			}
		</header>

		{
			cover && (
				<img
					class="mt-6 w-full rounded-xl border border-[var(--border)] object-cover"
					src={cover}
					alt={title}
				/>
			)
		}

		<div class="prose mt-8">
			<Content />
		</div>

		{
			(prevPost || nextPost) && (
				<nav class="mt-10 flex justify-between gap-4 border-t border-[var(--border)] pt-5" aria-label="上一篇 / 下一篇">
					{
						nextPost ? (
							<a
								class="group flex min-w-0 flex-1 flex-col gap-1 rounded-[var(--radius-card)] border border-[var(--border)] p-3 text-left no-underline transition-all duration-150 hover:border-[var(--border-strong)] hover:shadow-[var(--shadow)]"
								href={`/blog/${nextPost.id}/`}
							>
								<span class="text-xs text-[var(--text-faint)]">← 下一篇</span>
								<span class="truncate text-sm font-medium text-[var(--text)]">
									{nextPost.data.title}
								</span>
							</a>
						) : (
							<span class="flex-1" aria-hidden="true" />
						)
					}
					{
						prevPost ? (
							<a
								class="group flex min-w-0 flex-1 flex-col gap-1 rounded-[var(--radius-card)] border border-[var(--border)] p-3 text-right no-underline transition-all duration-150 hover:border-[var(--border-strong)] hover:shadow-[var(--shadow)]"
								href={`/blog/${prevPost.id}/`}
							>
								<span class="text-xs text-[var(--text-faint)]">上一篇 →</span>
								<span class="truncate text-sm font-medium text-[var(--text)]">
									{prevPost.data.title}
								</span>
							</a>
						) : (
							<span class="flex-1" aria-hidden="true" />
						)
					}
				</nav>
			)
		}
	</article>
</MainLayout>
