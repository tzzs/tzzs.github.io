---
// 博客文章详情页
// - 仅生成非草稿文章；草稿不生成页面（访问即 404）
// - 正文中的 [TOC] 标记由 remark-toc-marker 插件在 markdown 渲染阶段
//   替换为文章目录（h1-h3 锚点列表），无需在此额外处理
import { type CollectionEntry, getCollection, render } from 'astro:content';
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { title, description, pubDate, updated, tags = [], categories = [] } = post.data;
const { Content } = await render(post);

// 上一篇 / 下一篇：按 pubDate 降序排序，比当前文章新的是「下一篇」
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const prevPost =
	currentIndex >= 0 && currentIndex < allPosts.length - 1
		? allPosts[currentIndex + 1]
		: undefined;

const dateText = (d: Date) =>
	d.toLocaleDateString('zh-CN', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
---

<SidebarLayout title={`${title} | ${SITE_TITLE}`} description={description}>
	<article class="post">
		<header class="post-header">
			<h1>{title}</h1>
			<div class="post-meta">
				<time datetime={pubDate.toISOString()}>{dateText(pubDate)}</time>
				{
					updated && (
						<span class="post-updated">
							更新于
							<time datetime={updated.toISOString()}>{dateText(updated)}</time>
						</span>
					)
				}
				{
					categories.length > 0 && (
						<span class="post-categories">
							{categories.map((c) => (
								<a class="pill" href={`/blog/categories/${encodeURIComponent(c)}/`}>
									{c}
								</a>
							))}
						</span>
					)
				}
			</div>
			{
				tags.length > 0 && (
					<ul class="tag-list post-tags">
						{tags.map((tag) => (
							<li>
								<a href={`/blog/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
							</li>
						))}
					</ul>
				)
			}
		</header>

		<div class="prose">
			<Content />
		</div>

		{
			(prevPost || nextPost) && (
				<nav class="post-nav" aria-label="上一篇 / 下一篇">
					{
						nextPost ? (
							<a class="post-nav-item post-nav-next" href={`/blog/${nextPost.id}/`}>
								<span class="post-nav-label">下一篇</span>
								<span class="post-nav-title">{nextPost.data.title}</span>
							</a>
						) : (
							<span class="post-nav-item" aria-hidden="true" />
						)
					}
					{
						prevPost ? (
							<a class="post-nav-item post-nav-prev" href={`/blog/${prevPost.id}/`}>
								<span class="post-nav-label">上一篇</span>
								<span class="post-nav-title">{prevPost.data.title}</span>
							</a>
						) : (
							<span class="post-nav-item" aria-hidden="true" />
						)
					}
				</nav>
			)
		}
	</article>
</SidebarLayout>

<style>
	.post-header {
		margin-bottom: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border);
	}
	.post-header h1 {
		margin: 0 0 0.75rem;
		font-size: 1.9rem;
		line-height: 1.3;
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		font-size: 0.85rem;
		color: var(--text-faint);
	}
	.post-updated {
		font-style: italic;
	}
	.post-categories {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}
	.post-categories .pill {
		display: inline-block;
		padding: 1px 10px;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.8rem;
		color: var(--text-soft);
		text-decoration: none;
	}
	.post-categories .pill:hover {
		border-color: var(--accent);
		color: var(--accent);
		text-decoration: none;
	}
	.post-tags {
		margin-top: 0.75rem;
	}

	.post-nav {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}
	.post-nav-item {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		text-decoration: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	a.post-nav-item:hover {
		border-color: var(--border-strong);
		box-shadow: var(--shadow);
		text-decoration: none;
	}
	.post-nav-next {
		text-align: left;
	}
	.post-nav-prev {
		text-align: right;
	}
	.post-nav-label {
		font-size: 0.75rem;
		color: var(--text-faint);
	}
	.post-nav-title {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text);
		font-size: 0.95rem;
	}
</style>

<style is:global>
	/* 正文内 [TOC] 生成的目录（class 由 remark-toc-marker 插件写入） */
	.article-toc {
		margin: 1.5em 0;
		padding: 1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-soft);
		list-style: none;
	}
	.article-toc > li {
		margin: 0.25em 0;
	}
	.article-toc li {
		list-style: none;
	}
	.article-toc ul {
		list-style: none;
		padding-left: 1.25em;
		margin: 0.25em 0;
	}
	.article-toc a {
		color: var(--text-soft);
		text-decoration: none;
		font-size: 0.95em;
		transition: color 0.15s ease;
	}
	.article-toc a:hover {
		color: var(--accent);
		text-decoration: none;
	}
</style>
