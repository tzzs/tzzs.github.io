---
// 博客归档页：按年份分组展示全部非草稿文章
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 按年份分组（年份降序，组内按 pubDate 降序）
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	if (!byYear.has(year)) byYear.set(year, []);
	byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const dateText = (d: Date) =>
	d.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' });
---

<MainLayout title={`归档 | ${SITE_TITLE}`} description="博客文章归档，按年份浏览">
	<header class="mb-6">
		<h1 class="text-3xl font-bold">归档</h1>
		<p class="mt-1 text-sm text-[var(--text-faint)]">共 {posts.length} 篇文章</p>
	</header>

	{
		years.map((year) => (
			<section class="mb-8">
				<h2 class="mb-3 flex items-baseline gap-2 border-b border-[var(--border)] pb-1.5 text-xl font-bold">
					{year}
					<span class="text-xs font-normal text-[var(--text-faint)]">
						{byYear.get(year)!.length}
					</span>
				</h2>
				<ul class="m-0 list-none p-0">
					{
						byYear.get(year)!.map((post) => (
							<li class="flex items-baseline gap-4 py-1.5">
								<time
									class="flex-none basis-[4.5em] text-sm text-[var(--text-faint)] tabular-nums"
									datetime={post.data.pubDate.toISOString()}
								>
									{dateText(post.data.pubDate)}
								</time>
								<a
									class="text-[var(--text)] no-underline transition-colors duration-150 hover:text-[var(--accent)] hover:underline"
									href={`/blog/${post.id}/`}
								>
									{post.data.title}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		))
	}
</MainLayout>
