---
// 博客归档页：按年份分组展示全部非草稿文章
import { getCollection } from 'astro:content';
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 按年份分组（年份降序，组内按 pubDate 降序）
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	if (!byYear.has(year)) byYear.set(year, []);
	byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const dateText = (d: Date) =>
	d.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' });
---

<SidebarLayout title={`归档 | ${SITE_TITLE}`} description="博客文章归档，按年份浏览">
	<header class="page-header">
		<h1>归档</h1>
		<p class="page-sub">共 {posts.length} 篇文章</p>
	</header>

	{
		years.map((year) => (
			<section class="archive-year">
				<h2 class="archive-year-title">
					{year}
					<span class="archive-year-count">{byYear.get(year)!.length}</span>
				</h2>
				<ul class="archive-list">
					{
						byYear.get(year)!.map((post) => (
							<li class="archive-item">
								<time datetime={post.data.pubDate.toISOString()}>
									{dateText(post.data.pubDate)}
								</time>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</li>
						))
					}
				</ul>
			</section>
		))
	}
</SidebarLayout>

<style>
	.page-header {
		margin-bottom: 1.5rem;
	}
	.page-header h1 {
		margin: 0 0 0.25rem;
		font-size: 1.8rem;
	}
	.page-sub {
		margin: 0;
		color: var(--text-faint);
		font-size: 0.9rem;
	}

	.archive-year {
		margin-bottom: 2rem;
	}
	.archive-year-title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0 0 0.75rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--border);
		font-size: 1.3rem;
	}
	.archive-year-count {
		font-size: 0.8rem;
		font-weight: 400;
		color: var(--text-faint);
	}
	.archive-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.archive-item {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 0.35rem 0;
	}
	.archive-item time {
		flex: 0 0 4.5em;
		font-size: 0.85rem;
		color: var(--text-faint);
		font-variant-numeric: tabular-nums;
	}
	.archive-item a {
		color: var(--text);
		text-decoration: none;
	}
	.archive-item a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
</style>
