---
// 分类聚合页：列出某一分类下的全部非草稿文章（按 pubDate 降序）
import { getCollection } from 'astro:content';
import SidebarLayout from '../../../../layouts/SidebarLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import { SITE_TITLE } from '../../../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	const categories = [...new Set(posts.flatMap((p) => p.data.categories ?? []))].sort();
	return categories.map((category) => ({
		params: { category },
		props: {
			category,
			posts: posts
				.filter((p) => (p.data.categories ?? []).includes(category))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { category, posts } = Astro.props;
---

<SidebarLayout
	title={`分类：${category} | ${SITE_TITLE}`}
	description={`分类「${category}」下的全部文章`}
>
	<header class="page-header">
		<h1>分类：{category}</h1>
		<p class="page-sub">共 {posts.length} 篇文章</p>
	</header>

	{
		posts.length > 0 ? (
			<div class="post-list">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		) : (
			<p class="empty">该分类下暂无文章。</p>
		)
	}
</SidebarLayout>

<style>
	.page-header {
		margin-bottom: 1.5rem;
	}
	.page-header h1 {
		margin: 0 0 0.25rem;
		font-size: 1.8rem;
	}
	.page-sub {
		margin: 0;
		color: var(--text-faint);
		font-size: 0.9rem;
	}
	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.empty {
		color: var(--text-faint);
	}
</style>
