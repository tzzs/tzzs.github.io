---
// 联系页（Positivus 风格）：大标题「联系」+ GitHub Issues / 开源主页 / 说明
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_TITLE } from '../consts';

const githubProfile = 'https://github.com/tzzs';
const githubIssues = 'https://github.com/tzzs/tzzs.github.io/issues';
---

<MainLayout
	title={`联系 - ${SITE_TITLE}`}
	description="联系 TZZ：GitHub Issues 与开源主页"
>
	<article class="py-12 md:py-16">
		<header>
			<h1 class="text-5xl font-medium leading-none md:text-7xl">
				联系<span class="ml-3 inline-block rounded-2xl bg-green px-3 py-1">我</span>
			</h1>
			<p class="mt-7 max-w-2xl text-lg leading-relaxed text-[var(--text-soft)]">
				有任何问题、建议或合作意向，欢迎通过以下方式联系。
			</p>
		</header>

		<div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
			<section class="rounded-[var(--radius-card)] border-2 border-black bg-gray p-7 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[var(--shadow)]">
				<div class="flex items-center justify-between gap-4">
					<h2 class="text-xl font-medium">GitHub Issues</h2>
					<span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-green" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
							<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
						</svg>
					</span>
				</div>
				<p class="mt-4 text-sm leading-relaxed text-[var(--text-soft)]">
					遇到本站或应用的 Bug、有功能建议，欢迎到
					<a class="font-medium text-accent underline-offset-4 hover:underline" href={githubIssues} rel="noopener noreferrer" target="_blank">仓库 Issues</a>
					反馈，我会尽快跟进处理。
				</p>
			</section>

			<section class="rounded-[var(--radius-card)] border-2 border-black bg-gray p-7 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[var(--shadow)]">
				<div class="flex items-center justify-between gap-4">
					<h2 class="text-xl font-medium">开源主页</h2>
					<span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-green" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
							<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
						</svg>
					</span>
				</div>
				<p class="mt-4 text-sm leading-relaxed text-[var(--text-soft)]">
					我的开源项目与代码仓库：
					<a class="font-medium text-accent underline-offset-4 hover:underline" href={githubProfile} rel="noopener noreferrer" target="_blank">{githubProfile}</a>
				</p>
			</section>

			<section class="rounded-[var(--radius-card)] border-2 border-black bg-gray p-7 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[var(--shadow)] md:col-span-2">
				<div class="flex items-center justify-between gap-4">
					<h2 class="text-xl font-medium">说明</h2>
					<span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-green" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="12" y1="16" x2="12" y2="12"></line>
							<line x1="12" y1="8" x2="12.01" y2="8"></line>
						</svg>
					</span>
				</div>
				<p class="mt-4 text-sm leading-relaxed text-[var(--text-soft)]">
					回复一般需要 1-3 个工作日；问题反馈请尽量描述复现步骤与环境，便于快速定位。
				</p>
			</section>
		</div>
	</article>
</MainLayout>
